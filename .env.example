BYBIT_API_KEY=put_your_key_here
BYBIT_API_SECRET=put_your_secret_here

# Keep true until you intentionally switch to live orders.
BYBIT_DRY_RUN=true
BYBIT_BASE_URL=https://api.bybit.com

# Default order settings used by `npm run bybit:order`.
BYBIT_CATEGORY=spot
BYBIT_SYMBOL=BTCUSDT
BYBIT_SIDE=Buy
BYBIT_ORDER_TYPE=Limit
BYBIT_QTY=0.0001
BYBIT_PRICE=50000
BYBIT_TIME_IN_FORCE=GTC

# Hybrid trading brain settings. Read-only: it does not send orders.
BRAIN_DRY_RUN=true
BRAIN_CATEGORY=spot
BRAIN_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,LINKUSDT,XAUUSDT,XAGUSDT,TSLAUSDT,NVDAUSDT,CLUSDT,XAUTUSDT,USDTEUR,BTCEUR,ETHEUR
# TradFi perpetuals use Bybit linear category (gold, oil, US stocks).
BRAIN_LINEAR_SYMBOLS=XAUUSDT,XAGUSDT,TSLAUSDT,NVDAUSDT,CLUSDT
BRAIN_INTERVAL=15
BRAIN_KLINE_LIMIT=96
BRAIN_MIN_CONFIDENCE=65
BRAIN_MAX_RISK_SCORE=55
BRAIN_MAX_POSITION_USD=20
BRAIN_MAX_DAILY_LOSS_USD=5
BRAIN_LOOP_INTERVAL_SECONDS=300
BRAIN_DATA_DIR=./data
BRAIN_NEWS_LOOKBACK_HOURS=12
BRAIN_NEWS_SOURCES=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://news.google.com/rss/search?q=Bitcoin%20OR%20Ethereum%20OR%20CryptoNews%20when:1d&hl=en-US&gl=US&ceid=US:en
BRAIN_HTML_NEWS_SOURCES=https://forklog.com/en/news-and-analysis/,https://t.me/s/forklogfeed

# Crypto Fear & Greed Index (alternative.me, no API key required).
FEAR_GREED_ENABLED=true
FEAR_GREED_URL=https://api.alternative.me/fng/
FEAR_GREED_TIMEOUT_MS=10000

# Optional AI Analyst. Disabled until an OpenAI-compatible key is configured.
AI_ANALYST_ENABLED=false
AI_ANALYST_PROVIDER=deepseek
AI_ANALYST_BASE_URL=https://api.deepseek.com
AI_ANALYST_API_KEY=
AI_ANALYST_MODEL=deepseek-chat
AI_ANALYST_TIMEOUT_MS=20000
AI_ANALYST_MIN_CONFIDENCE=60

# Optional Cursor Analyst. Requires a Cursor API key from Cursor dashboard.
CURSOR_ANALYST_ENABLED=false
CURSOR_API_KEY=
CURSOR_ANALYST_MODEL=auto
CURSOR_ANALYST_TIMEOUT_MS=60000
CURSOR_ANALYST_MIN_CONFIDENCE=60
CURSOR_ANALYST_CWD=.

# AlgoVault quant analyst via crypto-quant-signal-mcp (free tier, no API key).
ALGOVAULT_ENABLED=true
ALGOVAULT_MCP_URL=https://api.algovault.com/mcp
ALGOVAULT_EXCHANGE=BYBIT
ALGOVAULT_FETCH_REGIME=true
ALGOVAULT_MIN_CONFIDENCE=55
ALGOVAULT_TIMEOUT_MS=20000
ALGOVAULT_ATTACH_TO_CURSOR=true

# Paper trading and signal quality. Virtual only; no exchange orders.
PAPER_TRADING_ENABLED=true
PAPER_START_BALANCE_USD=1000
PAPER_MAX_POSITION_USD=20
PAPER_MIN_CONFIDENCE=70
PAPER_FEE_RATE=0.001
PAPER_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XAUUSDT,XAGUSDT,TSLAUSDT,NVDAUSDT,CLUSDT,XAUTUSDT,USDTEUR,BTCEUR,ETHEUR
PAPER_REQUIRE_DEEPSEEK_OK=true
PAPER_REQUIRE_CURSOR_OK=true

# Scalp strategy (Murphy+Solabuto + Borovkov/CScalp/Shiryaev/Young knowledge base) on 5m candles.
SCALP_ENABLED=true
SCALP_INTERVAL=5
SCALP_MIN_CONFIDENCE=62
SCALP_TAKE_PROFIT_PCT=0.35
SCALP_STOP_LOSS_PCT=0.18
SCALP_MAX_SPREAD_PCT=0.08
SCALP_PAPER_ENABLED=true
SCALP_MAX_POSITION_USD=15
SCALP_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SCALP_ALLOWED_ASSET_CLASSES=crypto
SCALP_KNOWLEDGE_PATH=
FEE_POLICY_PATH=

# Regime gate (ADX + volatility): trend_up / trend_down / range / volatile / transition
REGIME_GATE_ENABLED=true
REGIME_ADX_TREND_MIN=22
REGIME_VOLATILITY_HIGH_PCT=3.2
REGIME_RANGE_TREND_MAX_PCT=0.35

# Ensemble scoring weights (technical / order book / derivatives / sentiment)
ENSEMBLE_SCORING_ENABLED=true
ENSEMBLE_WEIGHT_TECHNICAL=0.40
ENSEMBLE_WEIGHT_MICROSTRUCTURE=0.15
ENSEMBLE_WEIGHT_DERIVATIVES=0.20
ENSEMBLE_WEIGHT_SENTIMENT=0.25

# Auto-adjust min confidence from signal quality hit-rate (15m horizon)
QUALITY_FEEDBACK_ENABLED=true
QUALITY_FEEDBACK_MIN_SAMPLES=5
QUALITY_FEEDBACK_POOR_HIT_RATE=45
QUALITY_FEEDBACK_GOOD_HIT_RATE=55
QUALITY_FEEDBACK_CONFIDENCE_PENALTY=8
QUALITY_FEEDBACK_CONFIDENCE_BONUS=3

# Historical backtest (rules-only, no AI). Writes data/backtest-latest.json
BACKTEST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BACKTEST_INTERVAL=15
BACKTEST_CANDLE_LIMIT=500
BACKTEST_WARMUP_BARS=60
BACKTEST_MIN_CONFIDENCE=70
BACKTEST_START_BALANCE_USD=1000
BACKTEST_MAX_POSITION_USD=20
BACKTEST_FEE_RATE=0.001
BACKTEST_MODE=rules

# Finam Trade API (market data + account read). NEVER commit real secret.
# Trade codes 791750REXQ4 / 791750RM43P map to API account_ids below.
FINAM_ENABLED=false
FINAM_BASE_URL=https://api.finam.ru
FINAM_SECRET_TOKEN=
FINAM_ACCOUNT_IDS=1748987,2076665
FINAM_TRADE_CODES=791750REXQ4,791750RM43P
FINAM_ACCOUNT_1748987_CODE=791750REXQ4
FINAM_ACCOUNT_1748987_ROLE=long
FINAM_ACCOUNT_1748987_LABEL=Длинные / свинг
FINAM_ACCOUNT_2076665_CODE=791750RM43P
FINAM_ACCOUNT_2076665_ROLE=day
FINAM_ACCOUNT_2076665_LABEL=Дневной тариф / intraday
FINAM_LONG_ACCOUNT_ID=1748987
FINAM_DAY_ACCOUNT_ID=2076665
FINAM_SYMBOLS=SBER@MISX,GAZP@MISX,LKOH@MISX,ROSN@MISX,USD000UTSTOM@MISX,CNYRUB_TOM@MISX,GLDRUB_TOM@MISX,AAPL@XNGS,TSLA@XNGS
# Day-tariff symbols (futures / FX maker >=50 lots) — add later; route to 791750RM43P
FINAM_DAY_SYMBOLS=
FINAM_TIMEFRAME=TIME_FRAME_M15
FINAM_BAR_LOOKBACK_HOURS=48
FINAM_AI_ENABLED=false
FINAM_TRADING_ENABLED=false
FINAM_MIN_CONFIDENCE=65
FINAM_MAX_POSITION_RUB=500
FINAM_MAX_OPEN_POSITIONS=3
FINAM_ORDER_TYPE=LIMIT
FINAM_ALLOW_SELL_CLOSE=true
